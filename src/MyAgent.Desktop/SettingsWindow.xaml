<Window x:Class="MyAgent.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки AI Harness"
        Width="760"
        Height="700"
        MinWidth="650"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock
                    Text="Модели"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,5" />

                <TextBlock
                    x:Name="ActiveProfileTextBlock"
                    Foreground="#666666"
                    Margin="0,0,0,10"
                    TextWrapping="Wrap" />

                <ListBox
                    x:Name="ProfilesListBox"
                    Height="190"
                    Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Text="{Binding Model}"
                                    FontSize="11"
                                    Foreground="#777777"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,0,0,18">

                    <Button
                        Width="140"
                        Height="34"
                        Margin="0,0,8,0"
                        Content="Добавить модель"
                        Click="AddProfileButton_Click" />

                    <Button
                        Width="150"
                        Height="34"
                        Content="Сделать активной"
                        Click="SetActiveProfileButton_Click" />

                    <Button
                        Width="100"
                        Height="34"
                        Margin="8,0,0,0"
                        Content="Изменить"
                        Click="EditProfileButton_Click" />

                    <Button
                        Width="100"
                        Height="34"
                        Margin="8,0,0,0"
                        Content="Удалить"
                        Click="DeleteProfileButton_Click" />

                </StackPanel>

                <Separator
                    Margin="0,0,0,18" />

                <TextBlock
                    Text="Workspace"
                    FontWeight="SemiBold" />

                <TextBox
                    x:Name="WorkspaceTextBox"
                    Margin="0,5,0,14"
                    Padding="7" />

                <TextBlock
                    Text="Max steps"
                    FontWeight="SemiBold" />

                <TextBox
                    x:Name="MaxStepsTextBox"
                    Margin="0,5,0,14"
                    Padding="7" />

                <TextBlock
                    Text="Max tool calls"
                    FontWeight="SemiBold" />

                <TextBox
                    x:Name="MaxToolCallsTextBox"
                    Margin="0,5,0,14"
                    Padding="7" />

                <TextBlock
                    Text="Terminal timeout, seconds"
                    FontWeight="SemiBold" />

                <TextBox
                    x:Name="TerminalTimeoutTextBox"
                    Margin="0,5,0,14"
                    Padding="7" />

                <TextBlock
                    Text="Изменения моделей сохраняются сразу. Остальные настройки применяются кнопкой «Сохранить»."
                    FontSize="11"
                    Foreground="#777777"
                    TextWrapping="Wrap" />

            </StackPanel>

        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,16,0,0">

            <Button
                Width="100"
                Height="36"
                Margin="0,0,8,0"
                Content="Отмена"
                Click="CancelButton_Click" />

            <Button
                Width="100"
                Height="36"
                Content="Сохранить"
                Click="SaveButton_Click" />

        </StackPanel>

    </Grid>

</Window>