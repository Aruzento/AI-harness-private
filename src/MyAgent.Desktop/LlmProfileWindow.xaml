<Window x:Class="MyAgent.Desktop.LlmProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить модель"
        Width="620"
        Height="570"
        MinWidth="520"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock
                    Text="Имя"
                    FontWeight="SemiBold" />

                <TextBox
                    x:Name="NameTextBox"
                    Margin="0,5,0,14"
                    Padding="7" />

                <TextBlock
                    Text="Тип API"
                    FontWeight="SemiBold" />

                <ComboBox
                    x:Name="ApiFormatComboBox"
                    Margin="0,5,0,14"
                    Padding="7"
                    IsReadOnly="True">
                    <ComboBoxItem
                        Content="OpenAI-compatible Chat Completions"
                        Tag="openai-chat-completions" />
                </ComboBox>

                <TextBlock
                    Text="Endpoint"
                    FontWeight="SemiBold" />

                <TextBox
                    x:Name="EndpointTextBox"
                    Margin="0,5,0,14"
                    Padding="7" />

                <TextBlock
                    Text="Model ID"
                    FontWeight="SemiBold" />

                <TextBox
                    x:Name="ModelTextBox"
                    Margin="0,5,0,14"
                    Padding="7" />

                <TextBlock
                    Text="API key"
                    FontWeight="SemiBold" />

                <PasswordBox
                    x:Name="ApiKeyPasswordBox"
                    Margin="0,5,0,5"
                    Padding="7" />

                <TextBlock
                    Text="Ключ будет сохранён отдельно и защищён Windows DPAPI."
                    FontSize="11"
                    Foreground="#777777"
                    TextWrapping="Wrap"
                    Margin="0,0,0,14" />

                <CheckBox
                    x:Name="MakeActiveCheckBox"
                    Content="Сделать активной"
                    Margin="0,4,0,0" />

            </StackPanel>

        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,16,0,0">

            <Button
                Width="100"
                Height="36"
                Margin="0,0,8,0"
                Content="Отмена"
                Click="CancelButton_Click" />

            <Button
                Width="100"
                Height="36"
                Content="Сохранить"
                Click="SaveButton_Click" />

        </StackPanel>

    </Grid>

</Window>