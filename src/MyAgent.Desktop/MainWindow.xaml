<Window x:Class="MyAgent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyAgent.Desktop"
        Title="AI Harness v0.1.4"
        Height="700"
        Width="900"
        MinHeight="450"
        MinWidth="600">

    <Window.Resources>

        <DataTemplate
            DataType="{x:Type local:UserMessageItem}">

            <StackPanel
                Margin="4,10,4,16">

                <TextBlock
                    Text="Вы"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Margin="0,0,0,5" />

                <TextBlock
                    Text="{Binding Text}"
                    FontSize="14"
                    TextWrapping="Wrap" />

            </StackPanel>

        </DataTemplate>

        <DataTemplate
            DataType="{x:Type local:AssistantMessageItem}">

            <StackPanel
                Margin="4,10,4,20">

                <TextBlock
                    Text="AI"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Margin="0,0,0,5" />

                <TextBlock
                    Text="{Binding Text}"
                    FontSize="14"
                    TextWrapping="Wrap" />

            </StackPanel>

        </DataTemplate>

        <DataTemplate
            DataType="{x:Type local:ActivityItem}">

            <TextBlock
                Text="{Binding Text}"
                FontSize="12"
                Foreground="#777777"
                TextWrapping="Wrap"
                Margin="18,1,4,1" />

        </DataTemplate>

        <DataTemplate
            DataType="{x:Type local:ApprovalItem}">

            <Border
                Margin="18,8,4,10"
                Padding="10"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Background="#F7F7F7"
                CornerRadius="6">

                <StackPanel>

                    <TextBlock
                        Text="Требуется разрешение"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Margin="0,0,0,4" />

                    <TextBlock
                        Text="{Binding ToolName}"
                        FontSize="11"
                        Foreground="#777777"
                        Margin="0,0,0,8" />

                    <Border
                        Padding="8"
                        Margin="0,0,0,10"
                        Background="#EEEEEE"
                        CornerRadius="4">

                        <TextBlock
                            Text="{Binding Text}"
                            FontFamily="Consolas"
                            FontSize="12"
                            TextWrapping="Wrap" />

                    </Border>

                    <StackPanel
                        x:Name="ApprovalButtons"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                        <Button
                            Content="Отклонить"
                            MinWidth="90"
                            Padding="10,5"
                            Margin="0,0,8,0"
                            Click="DenyTool_Click" />

                        <Button
                            Content="Разрешить"
                            MinWidth="90"
                            Padding="10,5"
                            Click="ApproveTool_Click" />

                    </StackPanel>

                    <TextBlock
                        x:Name="ApprovalDecision"
                        Text="{Binding DecisionText}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#666666"
                        Visibility="Collapsed" />

                </StackPanel>

            </Border>

            <DataTemplate.Triggers>

                <DataTrigger
                    Binding="{Binding IsPending}"
                    Value="False">

                    <Setter
                        TargetName="ApprovalButtons"
                        Property="Visibility"
                        Value="Collapsed" />

                    <Setter
                        TargetName="ApprovalDecision"
                        Property="Visibility"
                        Value="Visible" />

                </DataTrigger>

            </DataTemplate.Triggers>

        </DataTemplate>

    </Window.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="ConversationScrollViewer"
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="12"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <ItemsControl
                x:Name="ConversationItemsControl" />

        </ScrollViewer>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="InputTextBox"
                Grid.Column="0"
                MinHeight="80"
                MaxHeight="180"
                Margin="0,0,12,0"
                Padding="8"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />

            <Button
                x:Name="SendButton"
                Grid.Column="1"
                Width="110"
                Height="40"
                VerticalAlignment="Bottom"
                Content="Отправить"
                Click="SendButton_Click" />

        </Grid>

    </Grid>

</Window>